// For format details, see https://containers.dev/implementors/json_reference/
{
  "name": "Python 3 Developer Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "developer"
  },
  "privileged": true,
  "remoteEnv": {
    // Allow X11 apps to run inside the container
    "DISPLAY": "${localEnv:DISPLAY}",
    // Put things that allow it in the persistent cache
    "PRE_COMMIT_HOME": "/cache/pre-commit",
    "UV_CACHE_DIR": "/cache/uv",
    "UV_PYTHON_CACHE_DIR": "/cache/uv-python",
    "PATH": "/cache/venv-for${localWorkspaceFolder}/bin:${containerEnv:PATH}:/usr/local/cuda/bin",
    "LD_LIBRARY_PATH": "${containerEnv:LD_LIBRARY_PATH}:/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64",
    "CUDA_HOME": "/usr/local/cuda",
    // Make a venv that is specific for this workspace path as the cache is shared
    "UV_PROJECT_ENVIRONMENT": "/cache/venv-for${localWorkspaceFolder}",
    // Do the equivalent of "activate" the venv so we don't have to "uv run" everything
    "VIRTUAL_ENV": "/cache/venv-for${localWorkspaceFolder}",
    // Relocate Claude Code's config (OAuth token, account state, settings)
    // onto a persistent volume so we stay logged in across container rebuilds
    "CLAUDE_CONFIG_DIR": "/claude-config"
  },
  "customizations": {
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        // Use the container's python by default
        "python.defaultInterpreterPath": "/usr/bin/python",
        // Don't activate the venv as it is already in the PATH
        "python.terminal.activateEnvInCurrentTerminal": false,
        "python.terminal.activateEnvironment": false,
        // Workaround to prevent garbled python REPL in the terminal
        // https://github.com/microsoft/vscode-python/issues/25505
        "python.terminal.shellIntegration.enabled": false
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "ms-python.python",
        "github.vscode-github-actions",
        "tamasfe.even-better-toml",
        // "redhat.vscode-yaml",
        "ryanluker.vscode-coverage-gutters",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "tomoki1207.pdf",
        "anthropic.claude-code"
      ]
    }
  },
  // Also add:
  "workspaceFolder": "/workspaces/nn_motion_control",
  // Create the config folder for the bash-config feature and uv cache
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.config/terminal-config ${localEnv:HOME}/.config/devcontainer-claude-config",
  "runArgs": [
    // Allow container to access GPUs
    "--gpus=all",
    // Shared memory for PyTorch DataLoader
    "--ipc=host",
    // Unlimited locked memory (GPU buffers)
    "--ulimit",
    "memlock=-1",
    // 64MB stack size
    "--ulimit",
    "stack=67108864",
    // Allow the container to access the host X11 display and EPICS CA
    "--net=host",
    // Make sure SELinux does not disable with access to host filesystems like tmp
    "--security-opt=label=disable"
  ],
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    // Mount in the user terminal config folder so it can be edited
    {
      "source": "${localEnv:HOME}/.config/terminal-config",
      "target": "/user-terminal-config",
      "type": "bind"
    },
    // Keep a persistent cross container cache for uv, pre-commit and the venvs
    {
      "source": "devcontainer-shared-cache",
      "target": "/cache",
      "type": "volume"
    },
    // Persist Claude Code's config dir (CLAUDE_CONFIG_DIR) so the auth token,
    // session transcripts and memory survive rebuilds. Uses a HOST BIND
    // MOUNT (not a named volume): on this box the Docker volume store lives
    // on ephemeral scratch and is wiped on rebuild, whereas the host home dir
    // is persistent. Same durable pattern as the terminal-config bind above.
    {
      "source": "${localEnv:HOME}/.config/devcontainer-claude-config",
      "target": "/claude-config",
      "type": "bind"
    }
  ],
  // Mount the parent as /workspaces so we can pip install peers as editable
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  // Setup the uv venv
  // The claude statusline installer is personal (lives in the user-terminal-config mount);
  // guarded so it is a harmless no-op for anyone who does not have it.
  // Re-register the rtk (Rust Token Killer) Claude Code hook on every rebuild:
  // the binary comes from the Dockerfile and settings.json lives on the persistent
  // /claude-config mount, but `rtk init -g` is idempotent and self-heals the hook if
  // missing. CLAUDE_CONFIG_DIR is pinned so init targets the persistent config dir
  // (postCreateCommand does not reliably inherit remoteEnv); telemetry is pre-disabled
  // so a fresh config never prompts. Guarded to a no-op if rtk is absent.
  "postCreateCommand": "cd /workspaces/nn_motion_control && uv sync && { [ -f package.json ] && npm install --no-audit --no-fund || true; } && { [ -f /user-terminal-config/claude/install-statusline.sh ] && bash /user-terminal-config/claude/install-statusline.sh || true; } && { command -v rtk >/dev/null 2>&1 && { rtk telemetry disable >/dev/null 2>&1; CLAUDE_CONFIG_DIR=/claude-config rtk init -g --auto-patch >/dev/null 2>&1; } || true; }"
}
