{
  "model_name": "deltabot_controller_tcn_recurrent_long",
  "system": "../system.toml",
  "run": {
    "out_dir": "../runs",
    "seed": 42
  },
  "plant": "champion:plant_tcn",
  "controller": {
    "features": ["position", "velocity", "reference", "reference_velocity", "error"],
    "hidden": [128, 128],
    "quant": [
      {
        "weight_bits": 16,
        "act_bits": 48
      },
      {
        "weight_bits": 16,
        "act_bits": 16
      },
      {
        "weight_bits": 16,
        "act_bits": 16
      }
    ],
    "servo_rate_hz": 10000,
    "training": {
      "horizon": 500,
      "curriculum_start": 24,
      "curriculum_ramp": 20,
      "tracking_weight": 1.0,
      "velocity_weight": 0.0,
      "effort_weight": 0.001,
      "rate_weight": 0.001,
      "huber_delta": 100.0,
      "reference": {
        "kind": "mixed",
        "xy": [0, 1],
        "radius": [100.0, 1200.0],
        "angular": [0.002, 0.02],
        "z_rate": [-20.0, 20.0],
        "step": [-800.0, 800.0],
        "smooth_amp": [0.0, 250.0],
        "components": 3,
        "weights": [1.0, 1.0, 1.0, 1.0]
      },
      "seed_quiescence": {
        "max_dac": 20.0,
        "max_speed": 2.0
      },
      "start_stride": 16,
      "val_start_stride": 32,
      "val_horizon": 2000
    },
    "batch_size": 256,
    "max_epochs": 60,
    "patience": 15,
    "min_delta": 0.001,
    "learning_rate": 0.001,
    "optimiser": "Adam",
    "architecture": "recurrent",
    "error_scale": 100.0,
    "recurrent": {
      "n_leaky": 3,
      "n_resonant": 2,
      "leaky_tau_s": [0.002, 0.015],
      "readout": "mlp"
    }
  }
}
