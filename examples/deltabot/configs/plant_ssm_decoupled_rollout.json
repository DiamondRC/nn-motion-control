{
  "system": "../system.toml",
  "role": "plant",
  "model_name": "deltabot_plant_ssm_decoupled_rollout",
  "architecture": {
    "window_size": 64,
    "decoupled": {
      "dynamic": [
        { "DiagSSM": [6, 128, 64] },
        { "DiagSSM": [128, 128, 64] },
        { "DiagSSM": [128, 128, 64] },
        { "DiagSSM": [128, 128, 64] }
      ],
      "static": [{ "Linear": [3, 32] }, "ReLU"],
      "head": [{ "Linear": [160, 128] }, "ReLU", { "Linear": [128, 3] }]
    }
  },
  "inputs": ["position", "velocity", "dac"],
  "targets": {
    "position": { "form": "delta", "weight": 1 }
  },
  "data": "../data/plant_dataset.h5",
  "training": {
    "batch_size": 8192,
    "max_epochs": 15,
    "patience": 15,
    "min_delta": 0,
    "learning_rate": 1e-6,
    "optimiser": "AdamW",
    "grad_scaler": "GradScaler",
    "loss_function": "WeightedMSELoss",
    "training_dtype": "bfloat16",
    "accumulation_steps": 1,
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_display_num": 3,
    "dataloader": { "auto_tune": false, "cpu_util": 80, "num_workers": 8, "prefetch_factor": 4 }
  },
  "rollout": {
    "rollout_kind": "decoupled",
    "horizon": 16,
    "curriculum_start": 2,
    "curriculum_ramp": 4,
    "ss_start": 1.0,
    "ss_end": 0.0,
    "ss_ramp": 7,
    "step_weight": 0.1,
    "horizon_weighting": "uniform",
    "start_stride": 8,
    "val_start_stride": 32
  },
  "run": {
    "seed": 42,
    "out_dir": "../runs",
    "verbose_logging": true,
    "compile": false,
    "channels_last": false,
    "init_checkpoint": "../runs/deltabot_plant_ssm_decoupled/deltabot_plant_ssm_decoupled.pth"
  }
}
