{
  "system": "../system.toml",
  "role": "plant",
  "model_name": "deltabot_plant_mlp",
  "architecture": {
    "window_size": 32,
    "hidden_layers": [
      { "Linear": [9, 256] },
      "ReLU",
      { "LayerNorm": [256] },
      { "Dropout": [0.1] },
      { "Linear": [256, 128] },
      "ReLU",
      { "LayerNorm": [128] },
      { "Dropout": [0.1] },
      { "Linear": [128, 3] }
    ]
  },
  "inputs": ["position", "velocity", "dac"],
  "targets": {
    "position": { "form": "delta", "weight": 1 }
  },
  "data": "../data/plant_dataset.h5",
  "training": {
    "batch_size": 8192,
    "max_epochs": 2000,
    "patience": 100,
    "min_delta": 1e-5,
    "learning_rate": 3e-4,
    "optimiser": "AdamW",
    "grad_scaler": "GradScaler",
    "loss_function": "WeightedMSELoss",
    "training_dtype": "bfloat16",
    "accumulation_steps": 1,
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_display_num": 3,
    "dataloader": { "auto_tune": false, "cpu_util": 80, "num_workers": 8, "prefetch_factor": 4 }
  },
  "run": { "seed": 42, "out_dir": "../runs", "verbose_logging": true }
}
