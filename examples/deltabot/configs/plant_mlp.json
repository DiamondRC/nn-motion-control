{
  "system": "../system.toml",
  "role": "plant",
  "model_name": "deltabot_plant_mlp",
  "architecture": {
    "window_size": 40,
    "hidden_layers": [
      { "Linear": [15, 2048] },
      "ReLU",
      { "LayerNorm": [2048] },
      { "Dropout": [0.2] },
      { "Linear": [2048, 1024] },
      "ReLU",
      { "LayerNorm": [1024] },
      { "Dropout": [0.2] },
      { "Linear": [1024, 512] },
      "ReLU",
      { "LayerNorm": [512] },
      { "Dropout": [0.2] },
      { "Linear": [512, 256] },
      "ReLU",
      { "LayerNorm": [256] },
      { "Dropout": [0.2] },
      { "Linear": [256, 128] },
      "ReLU",
      { "LayerNorm": [128] },
      { "Dropout": [0.2] },
      { "Linear": [128, 512] },
      "ReLU",
      { "LayerNorm": [512] },
      { "Dropout": [0.2] },
      { "Linear": [512, 1024] },
      "ReLU",
      { "LayerNorm": [1024] },
      { "Dropout": [0.2] },
      { "Linear": [1024, 12] }
    ]
  },
  "inputs": ["position", "velocity", "acceleration", "jerk", "dac"],
  "targets": {
    "position": { "predict": "next", "weight": 1 },
    "velocity": { "predict": "next", "weight": 50 },
    "acceleration": { "predict": "next", "weight": 5 },
    "jerk": { "predict": "next", "weight": 1 }
  },
  "data": "../data/plant_dataset.h5",
  "training": {
    "batch_size": 8192,
    "max_epochs": 5000,
    "patience": 200,
    "min_delta": 1e-4,
    "learning_rate": 3e-4,
    "optimiser": "AdamW",
    "grad_scaler": "GradScaler",
    "loss_function": "WeightedMSELoss",
    "training_dtype": "float32",
    "accumulation_steps": 1,
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_display_num": 3,
    "dataloader": { "auto_tune": false, "cpu_util": 80, "num_workers": 8, "prefetch_factor": 4 }
  },
  "run": { "seed": 42, "out_dir": "../runs", "verbose_logging": true }
}
