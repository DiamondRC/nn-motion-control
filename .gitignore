# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
**/_version.py

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
cov.xml
.pytest_cache/
.mypy_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/
docs/_api

# PyBuilder
target/

# likely venv names
.venv*
venv*

# further build artifacts
lockfiles/

# ruff cache
.ruff_cache/

# ML data / run artifacts
# Anchor these so they match real data/run dirs, not the `data/` source package
# (an unanchored `data/` would swallow src/nn_motion_control/data/).
archive/
/data/
/runs/
examples/*/data/
examples/*/runs/
examples/*/reports/
*.pth
*.h5
logs/

# Node (dev tooling: Prettier)
node_modules/

# temp
actor_critic.py

